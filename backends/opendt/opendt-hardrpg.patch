+
+std::map<std::string, std::string>& replaced() {
+  static std::map<std::string, std::string> m;
+  return m;
+}
+
+// The printf conversions of a template, in order ("s", "d", "lu"...).
+std::vector<std::string> conversions(const std::string& t) {
+  std::vector<std::string> out;
+  for (size_t i = 0; i < t.size(); ++i) {
+    const unsigned char c = static_cast<unsigned char>(t[i]);
+    if ((c >= 0x81 && c <= 0x9F) || (c >= 0xE0 && c <= 0xFC)) {
+      ++i;  // Shift-JIS lead byte: the next byte is never a '%'
+      continue;
+    }
+    if (c != '%') continue;
+    size_t j = i + 1;
+    while (j < t.size() && std::string("-+ #0123456789").find(t[j]) != std::string::npos) ++j;
+    std::string len;
+    while (j < t.size() && (t[j] == 'l' || t[j] == 'h')) len += t[j++];
+    if (j < t.size() && t[j] != '%') out.push_back(len + t[j]);
+    i = j;
+  }
+  return out;
+}
+
+bool sameKind(const std::string& a, const std::string& b) {
+  return (a.back() == 's') == (b.back() == 's');
+}
+
+}  // namespace
+
+void loadExeText(const std::string& root) {
+  replaced().clear();
+  std::vector<uint8_t> exe;
+  if (!core::tryReadFile(root, "RPG.EXE", exe) || exe.size() != 110607) return;
+  for (const Spot& s : k9606) {
+    const std::string stock = core::utf8ToSjis(s.stock);
+    if (s.offset + stock.size() >= exe.size()) continue;
+    std::string text(reinterpret_cast<const char*>(&exe[s.offset]), stock.size());
+    // The game's text fills the stock text's place exactly and ends there.
+    if (text == stock || exe[s.offset + stock.size()] != 0 || text.find('\0') != std::string::npos) continue;
+    const auto want = conversions(stock), got = conversions(text);
+    if (want.size() != got.size()) continue;
+    bool ok = true;
+    for (size_t i = 0; i < want.size(); ++i) ok = ok && sameKind(want[i], got[i]);
+    if (!ok) continue;
+    while (!text.empty() && text.back() == ' ') text.pop_back();
+    replaced().emplace(s.key ? s.key : s.stock, text);
+  }
+}
+
+int exeTextCount() { return int(replaced().size()); }
+
+std::string exeWord(const char* utf8) {
+  auto it = replaced().find(utf8);
+  if (it == replaced().end()) return core::utf8ToSjis(utf8);
+  // A number format in the player is wider than the EXE's (long long).
+  std::string t = it->second;
+  if (it->first.find("lld") != std::string::npos)
+    for (size_t p = t.find("ld"); p != std::string::npos; p = t.find("ld", p + 3)) t.insert(p, "l");
+  return t;
+}
+
+std::string exeMessage(const char* key, const std::vector<MsgArg>& args, const std::string& fallback) {
+  auto it = replaced().find(key);
+  if (it == replaced().end()) return fallback;
+  const std::string& t = it->second;
+  std::string out;
+  size_t arg = 0;
+  for (size_t i = 0; i < t.size(); ++i) {
+    const unsigned char c = static_cast<unsigned char>(t[i]);
+    if (((c >= 0x81 && c <= 0x9F) || (c >= 0xE0 && c <= 0xFC)) && i + 1 < t.size()) {
+      out += t[i];
+      out += t[++i];
+      continue;
+    }
+    if (c != '%') {
+      out += t[i];
+      continue;
+    }
+    size_t j = i + 1;
+    std::string flags;
+    while (j < t.size() && std::string("-+ #0123456789").find(t[j]) != std::string::npos) flags += t[j++];
+    while (j < t.size() && (t[j] == 'l' || t[j] == 'h')) ++j;
+    if (j >= t.size()) break;
+    const char conv = t[j];
+    i = j;
+    if (conv == '%') {
+      out += '%';
+      continue;
+    }
+    if (arg >= args.size()) return fallback;
+    const MsgArg& a = args[arg++];
+    char buf[256];
+    if (conv == 's')
+      std::snprintf(buf, sizeof buf, ("%" + flags + "s").c_str(), a.number ? std::to_string(a.n).c_str() : a.s.c_str());
+    else if (a.number)
+      std::snprintf(buf, sizeof buf, ("%" + flags + (conv == 'u' ? "llu" : "lld")).c_str(), a.n);
+    else
+      return fallback;
+    out += buf;
+  }
+  return out;
+}
+
+}  // namespace d2
