+    {0x1a0b4, "データ１"}, {0x1a0bd, "データ２"}, {0x1a0c6, "データ３"}, {0x1a0cf, "データ４"},
+    {0x1a15d, "使う"}, {0x1a162, "整理"}, {0x1a167, "捨てる"}, {0x1a16e, "やめる"},
+    {0x1a1ae, "はい"}, {0x1a1b4, "いいえ"},
+    {0x1a1db, "買う"}, {0x1a1e0, "売る"}, {0x1a1e6, "やめる"},
+    {0x1a1ed, "\\>宿泊料金は%d%sです。"}, {0x1a204, "\\>泊まりますか？"},
+    {0x1a27d, "それぞれ%luの経験値を獲得！"}, {0x1a299, "お金を%lu%s手に入れた！"},
+    {0x1a2b1, "%sを手に入れた！"}, {0x1a2c2, "%sはレベル%dになった！"},
+    {0x1a2e3, "%sに%dのダメージ！"}, {0x1a2f6, "%sの%sを%d奪った！"},
