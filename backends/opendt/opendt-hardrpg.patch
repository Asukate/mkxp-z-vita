+// Where the stock messages sit in RPG.EXE builds, and what they say there. `key` is the
+// text the player asks for when it differs from the EXE's (a wider number format).
+struct Spot {
+  unsigned offset;
+  const char* stock;
+  const char* key = nullptr;
+};
+
