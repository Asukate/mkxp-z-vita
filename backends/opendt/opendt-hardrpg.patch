+    if (frameBorder) {
+      std::memset(o, kIndexBlack, 16);
+      std::memset(o + 624, kIndexBlack, 16);
+    }
+  }
+  if (!textEnabled) return;
+  for (int r = 0; r < 25; ++r)
+    for (int c = 0; c < 80; ++c) {
+      const uint8_t a = textAttr[r][c];
+      if (!(a & 1)) continue;
+      const bool rev = (a & 4) != 0;
+      const uint8_t color = uint8_t(kIndexText + ((a & 0x40) ? 1 : 0) + ((a & 0x80) ? 2 : 0) + ((a & 0x20) ? 4 : 0));
