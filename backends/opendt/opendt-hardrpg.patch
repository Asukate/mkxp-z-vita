+  const long total = long(kScreenW) * kScreenH;
+  for (int y = 0; y < kScreenH; ++y) {
+    uint8_t* o = out + size_t(y) * stride;
+    if (!graphicsOn || (frameBorder && (y < 16 || y >= 368))) {
+      std::memset(o, kIndexBlack, kScreenW);
+      continue;
+    }
+    int sy = y;
+    if (y < 384 && L) sy = (y < 384 - L) ? y + L : y - (384 - L);
+    long p = (long(sy) * kScreenW + long(hOffset) * 16) % total;
+    if (p < 0) p += total;
+    const long first = std::min<long>(kScreenW, total - p);
