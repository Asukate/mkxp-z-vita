@@ -0,0 +1,38 @@
+// Built-in messages from the game's own RPG.EXE (HardRPG addition, not part of the spec).
+// Fan translations of Dante98 II games translate the engine's built-in words and messages
+// by editing RPG.EXE in place: each message keeps its place and byte length, padded with
+// spaces. The player shows those words instead of the stock Japanese ones.
+#pragma once
+#include <string>
+#include <vector>
+
+namespace d2 {
+
+// Reads the replaced messages from root/RPG.EXE (known builds only).
+void loadExeText(const std::string& root);
+// Number of messages the game replaced (for logs and tests).
+int exeTextCount();
+
+// A built-in word or message without arguments: the game's text if it replaced it, else the
+// stock text (both Shift-JIS).
+std::string exeWord(const char* utf8);
+
+struct MsgArg {
+  std::string s;
+  long long n = 0;
+  bool number = false;
+  MsgArg(const std::string& v) : s(v) {}
+  MsgArg(const char* v) : s(v) {}
+  MsgArg(int v) : n(v), number(true) {}
+  MsgArg(long v) : n(v), number(true) {}
+  MsgArg(long long v) : n(v), number(true) {}
+  MsgArg(unsigned v) : n(v), number(true) {}
+  MsgArg(unsigned long v) : n(static_cast<long long>(v)), number(true) {}
+  MsgArg(unsigned long long v) : n(static_cast<long long>(v)), number(true) {}
+};
+
+// A message built from a printf template (`key` is RPG.EXE's stock template, UTF-8): when
+// the game replaced the template, fills the game's template with args; else returns fallback.
+std::string exeMessage(const char* key, const std::vector<MsgArg>& args, const std::string& fallback);
+
+}  // namespace d2
