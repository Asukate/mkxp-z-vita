diff --git a/cont.c b/cont.c
index 4b18ddd..d06dbe2 100644
--- a/cont.c
+++ b/cont.c
@@ -16,6 +16,10 @@
 #include <sys/mman.h>
 #endif
 
+#ifdef __vita__
+#include <psp2/kernel/threadmgr.h>
+#endif
+
 // On Solaris, madvise() is NOT declared for SUS (XPG4v2) or later,
 // but MADV_* macros are defined when __EXTENSIONS__ is defined.
 #ifdef NEED_MADVICE_PROTOTYPE_USING_CADDR_T
@@ -750,6 +754,36 @@ fiber_entry(struct coroutine_context * from, struct coroutine_context * to)
     rb_fiber_t *fiber = to->argument;
     rb_thread_t *thread = fiber->cont.saved_ec.thread_ptr;
 
+#if defined(__vita__) && defined(COROUTINE_PTHREAD_CONTEXT)
+    /*
+     * Vita pthread preserves pthread_attr_setstack()'s size but ignores its
+     * caller-provided address and asks the kernel for a separate stack.  The
+     * Fiber EC was initialized from the unused caller-owned interval in
+     * fiber_initialize_coroutine().  Anchor it to the stack this pthread is
+     * actually executing on before any Ruby Fiber code can run.
+     */
+    volatile VALUE vita_stack_anchor = 0;
+    SceKernelThreadInfo vita_thread_info = {0};
+    vita_thread_info.size = sizeof(vita_thread_info);
+
+    if (sceKernelGetThreadInfo(sceKernelGetThreadId(), &vita_thread_info) >= 0 &&
+        vita_thread_info.stack != NULL && vita_thread_info.stackSize > 0) {
+        char *stack_low = (char *)vita_thread_info.stack;
+        char *stack_high = stack_low + vita_thread_info.stackSize;
+        char *stack_anchor = (char *)&vita_stack_anchor;
+
+        if (stack_anchor > stack_low && stack_anchor < stack_high) {
+            rb_execution_context_t *ec = &fiber->cont.saved_ec;
+
+            /* ARM/Vita uses a downward-growing machine stack.  This mirrors
+             * native_thread_init_stack(): stack_start is the entry-time live
+             * anchor, and stack_maxsize is the usable depth below it. */
+            ec->machine.stack_start = (VALUE *)&vita_stack_anchor;
+            ec->machine.stack_maxsize = (size_t)(stack_anchor - stack_low);
+        }
+    }
+#endif
+
 #ifdef COROUTINE_PTHREAD_CONTEXT
     ruby_thread_set_native(thread);
 #endif
diff --git a/coroutine/arm32/Context.S b/coroutine/arm32/Context.S
index 1850c4c..30922a1 100644
--- a/coroutine/arm32/Context.S
+++ b/coroutine/arm32/Context.S
@@ -9,6 +9,8 @@
 #define PREFIXED_SYMBOL(prefix,name) TOKEN_PASTE(prefix,name)
 
 .file "Context.S"
+.arch armv7-a
+.fpu neon
 .text
 .globl PREFIXED_SYMBOL(SYMBOL_PREFIX,coroutine_transfer)
 .align 2
@@ -19,13 +21,25 @@ PREFIXED_SYMBOL(SYMBOL_PREFIX,coroutine_transfer):
 	# Save caller state (8 registers + return address)
 	push {r4-r11,lr}
 
+	# Save callee-saved VFP registers (d8-d15) and FPSCR. Without this the
+	# resumed fiber sees the other fiber's floating point state; RGSS code
+	# keeps live values in these registers across the switch call.
+	vpush {d8-d15}
+	vmrs r3, fpscr
+	push {r3}
+
 	# Save caller stack pointer
 	str sp, [r0]
 
 	# Restore callee stack pointer
 	ldr sp, [r1]
 
-	# Restore callee state (8 registers program counter)
+	# Restore callee FP state
+	pop {r3}
+	vmsr fpscr, r3
+	vpop {d8-d15}
+
+	# Restore callee state (8 registers + program counter)
 	pop {r4-r11,pc}
 
 #if defined(__linux__) && defined(__ELF__)
diff --git a/coroutine/arm32/Context.h b/coroutine/arm32/Context.h
index 09410eb..1caeae6 100644
--- a/coroutine/arm32/Context.h
+++ b/coroutine/arm32/Context.h
@@ -19,6 +19,11 @@
 #define COROUTINE_LIMITED_ADDRESS_SPACE
 
 enum {COROUTINE_REGISTERS = 8};
+/* d8-d15 are callee-saved under the hard-float ABI (Vita is always built with
+ * -mfloat-abi=hard); their slots plus one FPSCR word live in the coroutine
+ * frame so coroutine_transfer in Context.S and coroutine_initialize agree on
+ * the layout. */
+enum {COROUTINE_VFP_REGISTERS = 16};
 
 struct coroutine_context
 {
@@ -48,6 +53,14 @@ static inline void coroutine_initialize(
 
     context->stack_pointer -= COROUTINE_REGISTERS;
     memset(context->stack_pointer, 0, sizeof(void*) * COROUTINE_REGISTERS);
+
+    // Mirror the frame built by coroutine_transfer in Context.S: the callee
+    // VFP registers (d8-d15), then the FPSCR word at the lowest address, so a
+    // freshly created fiber starts with a defined floating point state.
+    context->stack_pointer -= COROUTINE_VFP_REGISTERS;
+    memset(context->stack_pointer, 0, sizeof(void*) * COROUTINE_VFP_REGISTERS);
+    context->stack_pointer -= 1;
+    memset(context->stack_pointer, 0, sizeof(void*));
 }
 
 struct coroutine_context * coroutine_transfer(struct coroutine_context * current, struct coroutine_context * target);
