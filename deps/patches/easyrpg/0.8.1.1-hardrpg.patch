 void Player::Exit() {
 	if (player_config.settings_autosave.Get()) {
 		Scene_Settings::SaveConfig(true);
 	}
+#ifdef __vita__
+	// HardRPG: go back to the launcher before the display and audio threads
+	// are torn down. Saves and the config are already written.
+	HardRpgReturnToLauncher();
+#endif
 
