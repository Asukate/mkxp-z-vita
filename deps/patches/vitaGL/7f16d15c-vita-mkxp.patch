+/* S38: debug accessors for the diag build — expose the real vbo struct
+ * fields to mkxp-z without duplicating its layout. Buffer IDs ARE the
+ * vbo struct pointers (glGenBuffers returns (GLuint)gpu_buf). */
+void *vglGetBufferDataByID(GLuint id) {
+	vbo *b = (vbo *)id;
+	return b ? b->ptr : NULL;
+}
+
+int32_t vglGetBufferSizeByID(GLuint id) {
+	vbo *b = (vbo *)id;
+	return b ? b->size : -1;
+}
+
+uint32_t vglGetBufferLastFrameByID(GLuint id) {
+	vbo *b = (vbo *)id;
+	return b ? b->last_frame : 0;
+}
+
+/* S39d: texture info accessor — real gxm_tex + its storage. */
+void vglGetTexInfo(GLuint id, int *w, int *h, int *stride, void **data) {
+	texture *tex = &texture_slots[id];
+	if (w) *w = (int)sceGxmTextureGetWidth(&tex->gxm_tex);
+	if (h) *h = (int)sceGxmTextureGetHeight(&tex->gxm_tex);
+	if (stride) *stride = (int)sceGxmTextureGetStride(&tex->gxm_tex);
+	if (data) *data = (void *)sceGxmTextureGetData(&tex->gxm_tex);
+}
+
+/* S39g: full GXM texture descriptor dump. */
+void vglGetTexDescriptor(GLuint id, int *w, int *h, int *stride, int *format,
+                         int *mipcount, int *swizzle, unsigned int *flags,
+                         void **data) {
+	texture *tex = &texture_slots[id];
+	if (w) *w = (int)sceGxmTextureGetWidth(&tex->gxm_tex);
+	if (h) *h = (int)sceGxmTextureGetHeight(&tex->gxm_tex);
+	if (stride) *stride = (int)sceGxmTextureGetStride(&tex->gxm_tex);
+	if (format) *format = (int)sceGxmTextureGetFormat(&tex->gxm_tex);
+	if (mipcount) *mipcount = (int)sceGxmTextureGetMipmapCount(&tex->gxm_tex);
+	if (swizzle) *swizzle = (int)sceGxmTextureGetFormat(&tex->gxm_tex);
+	if (flags) *flags = (unsigned int)tex->gxm_tex.normalize_mode;
+	if (data) *data = (void *)sceGxmTextureGetData(&tex->gxm_tex);
+}
+
+/* S40: raw 4 control words of the descriptor. */
+void vglGetTexControlWords(GLuint id, unsigned int *cw0, unsigned int *cw1,
+                           unsigned int *cw2, unsigned int *cw3) {
+	texture *tex = &texture_slots[id];
+	SceGxmTextureInternal *t = (SceGxmTextureInternal *)&tex->gxm_tex;
+	if (cw0) *cw0 = t->control_words[0];
+	if (cw1) *cw1 = t->control_words[1];
+	if (cw2) *cw2 = t->control_words[2];
+	if (cw3) *cw3 = t->control_words[3];
+}
