+#ifdef RECYCLE_RENDERTARGETS
+static render_target *recycle_render_target(int w, int h, int max_refs, const char *reason) {
+	(void)reason;
+	uint32_t oldest_framecount = 0xFFFFFFFF;
+	render_target *r = NULL;
+	for (int i = 0; i < MAX_RENDER_TARGETS_NUM; i++) {
+		if (rt_list[i].rt && rt_list[i].last_frame < oldest_framecount) {
+			oldest_framecount = rt_list[i].last_frame;
+			r = &rt_list[i];
+		}
+	}
+	if (!r)
+		return NULL;
+
+	sceGxmFinish(gxm_context);
+	__vglInvalidateSharedRenderTarget(r);
+	sceGxmDestroyRenderTarget(r->rt);
+	r->rt = NULL;
+	r->ref_count = 0;
+	r->max_refs = max_refs;
+	int res = setup_render_target(&r->rt, w, h, max_refs);
+	if (res) {
+		r->rt = NULL;
+		return NULL;
+	}
+	r->w = w;
+	r->h = h;
+	r->ref_count = 1;
+	r->last_frame = vgl_framecount;
+	return r;
+}
+#endif
